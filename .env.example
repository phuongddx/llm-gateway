# Manifest API key — routes to 500+ models via app.manifest.build
MANIFEST_API_KEY=your-manifest-api-key-here

# Z.AI GLM Coding Plan key — routes glm-* models to https://api.z.ai/api/coding/paas/v4
# Unset to keep all GLM routing on Manifest
ZAI_CODING_API_KEY=

# GLM Coding Plan credit quotas (defaults = Max tier: 28000/5h, 140000/week)
ZAI_CREDITS_5H=28000
ZAI_CREDITS_WEEK=140000

# Fallback key (used if MANIFEST_API_KEY is not set)
LLM_API_KEY=your-api-key-here

# Gateway auth — REQUIRED, must be set before starting
APP_API_KEY=

# CORS — comma-separated allowed origins (empty = no CORS headers)
CORS_ORIGINS=

# Rate limiting (per client IP)
RATE_LIMIT=60/minute

# Analytics database path
ANALYTICS_DB_PATH=data/analytics.db

# Analytics write queue size (drops newest + logs when full)
ANALYTICS_QUEUE_SIZE=1000
